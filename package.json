{
  "name": "school-website",
  "version": "1.0.0",
  "description": "The school's public website and its content admin — separate from the management system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db-setup.ts",
    "db:check": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db-check.ts",
    "seed": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db-reset.ts",
    "test": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env test/verify.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
